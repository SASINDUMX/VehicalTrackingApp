# ==============================================================================
# UNITED MOTORS VEHICLE TRACKING — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# To configure your environments safely:
# 1. Create '.env.development' for your TEST/STAGING Supabase project (used by `npm run web`)
# 2. Create '.env.production' for your LIVE PRODUCTION Supabase project (used by `npm run build`)
#
# Expo automatically selects:
#   - '.env.development' when developing locally (NODE_ENV=development)
#   - '.env.production' when compiling for production (NODE_ENV=production)
# ==============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
